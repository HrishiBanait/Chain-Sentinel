# MST Testnet
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037
MST_TESTNET_EXPLORER_URL=https://testnet.mstscan.com

# MST Mainnet
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com/
MST_MAINNET_CHAIN_ID=4646
MST_MAINNET_EXPLORER_URL=https://mstscan.com

# Private keys are intentionally NOT defined yet.
# They are added to .env (never to this file) in Milestone 3.

# Deployed contract (public addresses only; filled in after deployment)
MST_TESTNET_REGISTRY_ADDRESS=
MST_TESTNET_ADMIN_ADDRESS=
MST_TESTNET_REPORTER_ADDRESS=
MST_TESTNET_DEPLOY_BLOCK=



# Test fixture token (public values only; filled in after deployment)
MST_TESTNET_DEPLOYER_ADDRESS=
MST_TESTNET_DEMO_TOKEN_ADDRESS=
MST_TESTNET_DEMO_TOKEN_DEPLOY_BLOCK=

# Monitor (backend)
MONITOR_NETWORK=testnet
MONITOR_CONFIRMATIONS=12
MONITOR_BATCH_SIZE=2000
MONITOR_POLL_INTERVAL_MS=6000
# Comma-separated ERC-20 addresses the large-transfer rule applies to (empty = rule inactive)
MONITOR_TOKENS=

# API (backend). Defaults shown; bind to 127.0.0.1 unless you deliberately expose it.
API_HOST=127.0.0.1
API_PORT=8787
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reporter / publisher. The private key is NEVER stored here: it is read from an encrypted keystore.
REPORTER_KEYSTORE_PATH=~/.foundry/keystores/cs-testnet-reporter
# Optional file holding the keystore password (chmod 600, outside the repo). Empty = prompt.
REPORTER_PASSWORD_FILE=
REPORTER_FEE_MODE=auto
REPORTER_MIN_TIP_GWEI=1
REPORTER_GAS_PRICE_GWEI=2
PUBLISH_MIN_SEVERITY=0
PUBLISH_POLL_INTERVAL_MS=15000
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_PENDING_GRACE_SECS=120

# Reporter / publisher. The private key is NEVER stored here: it is read from an encrypted keystore.
REPORTER_KEYSTORE_PATH=~/.foundry/keystores/cs-testnet-reporter
# Optional file holding the keystore password (chmod 600, outside the repo). Empty = prompt.
REPORTER_PASSWORD_FILE=
REPORTER_FEE_MODE=auto
REPORTER_MIN_TIP_GWEI=1
REPORTER_GAS_PRICE_GWEI=2
PUBLISH_MIN_SEVERITY=0
PUBLISH_POLL_INTERVAL_MS=15000
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_PENDING_GRACE_SECS=120

# Telegram notifications. The bot token is a secret: keep it only in .env (git-ignored) or a chmod-600 file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SEVERITY=0
NOTIFY_MAX_AGE_SECS=21600
NOTIFY_POLL_INTERVAL_MS=10000
NOTIFY_MAX_ATTEMPTS=5
# Must be a public URL (localhost links are ignored); leave empty to omit
NOTIFY_DASHBOARD_URL=

# Telegram notifications. The bot token is a secret: keep it only in .env (git-ignored) or a chmod-600 file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_SEVERITY=0
NOTIFY_MAX_AGE_SECS=21600
NOTIFY_POLL_INTERVAL_MS=10000
NOTIFY_MAX_ATTEMPTS=5
# Must be a public URL (localhost links are ignored); leave empty to omit
NOTIFY_DASHBOARD_URL=

# Scenario runner (testnet only)
SCENARIO_OWNER_KEYSTORE_PATH=~/.foundry/keystores/cs-testnet-deployer
SCENARIO_GAS_PRICE_GWEI=2
